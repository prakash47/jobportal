// JobPortal — Prisma 7 schema (SRS §8 Data Model).
// Generator: prisma-client (Rust-free) per CLAUDE.md §1.
// DATABASE_URL is provided by prisma.config.ts (loads root .env), not env() here.

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  // CJS output so node-runtime consumers (NestJS via nest build, ts-node)
  // can `require()` the client directly. ESM is the Prisma 7 default but
  // fights NestJS's tsc-emitted CommonJS module graph and ts-node's CJS
  // loader. Vitest still works either way.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

// How a user account authenticates. LOCAL = email + password (Argon2id).
// GOOGLE = OAuth via Google (no local password). SRS §4.12.6 (Phase 2 feature
// pulled into Phase 1 per ADR 0001). Add LinkedIn etc. here later.
enum AuthProvider {
  LOCAL
  GOOGLE
}

enum JobStatus {
  DRAFT
  PENDING_MODERATION
  ACTIVE
  EXPIRED
  CLOSED
}

// SRS §4.9.3 — wizard "employment type" step. The Schema.org JobPosting JSON-LD
// already references this set in apps/web/lib/seo/json-ld.ts.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

// SRS §4.9.3 — wizard "work mode" step. Filterable on the public SRP later.
enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

// Onboarding "Professional status" toggle (SRS §4.3). FRESHER hides the work-
// experience block; EXPERIENCED reveals it.
enum WorkStatus {
  FRESHER
  EXPERIENCED
}

// Onboarding "Looking for" toggle (SRS §4.3) — distinct axis from the
// preferredJobTypes (full-time/part-time/…) collected on the preferences step.
enum LookingFor {
  JOB
  INTERNSHIP
  BOTH
}

// SRS §4.3 — self-rated language proficiency for the candidate languages list.
enum LanguageProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// SRS §4.3 — optional self-identified gender on the candidate profile.
enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum FlagType {
  BOOLEAN
  TIER_GATED
  PERCENTAGE_ROLLOUT
  USER_TARGETED
  COHORT_TARGETED
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum EntitlementSource {
  SUBSCRIPTION
  ADMIN_GRANT
  PROMO
  REFERRAL
}

// Which storefront a plan belongs to: candidate-facing (apps/web) or
// recruiter-facing (recruiter portal /plans). Audience was previously implied
// only by each plan's featureKeys; the recruiter billing feature needs it
// explicit so /plans lists exactly the recruiter catalogue.
enum PlanAudience {
  CANDIDATE
  RECRUITER
}

// Razorpay Checkout order lifecycle. CREATED → PAID on signature-verified
// capture (webhook or the browser verify callback — both funnel into one
// idempotent activation); CREATED → FAILED on payment.failed. Abandoned
// checkouts stay CREATED and render as "Pending" in the billing history.
enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
}

// Formalises SubscriptionInvoice.status (previously an untyped String with
// zero runtime consumers). The MVP purchase flow writes PAID rows only —
// the invoice is issued at capture time.
enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// SRS §4.8 — career-advice article state machine. PUBLISHED articles render
// at /career-advice; DRAFT and ARCHIVED are admin-only. The ?status filter
// on the admin index will use this enum once the authoring tool lands
// (Task 19).
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// SRS §4.3.4 — resume scan status. PENDING is the initial state after upload;
// the ClamAV worker flips it to CLEAN or INFECTED. Only CLEAN resumes are
// returned by GET /me/resume.
enum ResumeScanStatus {
  PENDING
  CLEAN
  INFECTED
}

// SRS §4.3.6 — every profile edit writes one row of this enum's actions to
// ProfileAuditLog. The diff column captures before/after at field level.
// The RECRUITER_* / COMPANY_* actions cover the recruiter-portal profile editor
// (recruiter-personal fields, company fields, and the company-logo upload);
// they reuse the same audit table keyed by the recruiter's User id.
enum ProfileAuditAction {
  PROFILE_UPDATE
  EDUCATION_ADD
  EDUCATION_UPDATE
  EDUCATION_DELETE
  EXPERIENCE_ADD
  EXPERIENCE_UPDATE
  EXPERIENCE_DELETE
  SKILLS_UPDATE
  RESUME_UPLOAD
  RESUME_DELETE
  RECRUITER_PROFILE_UPDATE
  COMPANY_UPDATE
  COMPANY_LOGO_UPDATE
  // Recruiter Company Verification (KYC). SUBMIT/UPLOAD/DELETE are written with
  // the recruiter's User id; APPROVED/REJECTED with the reviewing admin's User
  // id. Same audit table, distinguished by the action.
  KYC_SUBMITTED
  KYC_DOCUMENT_UPLOAD
  KYC_DOCUMENT_DELETE
  KYC_APPROVED
  KYC_REJECTED
  // Admin job moderation. Both are written with the REVIEWING ADMIN's User id.
  // The diff carries the job id, the status transition and (on reject) the
  // admin-authored reason — never the job's title or description, matching the
  // minimisation rule the KYC and support audit rows already follow.
  JOB_APPROVED
  JOB_REJECTED
  // Recruiter self-service password change (Settings → Change Password). Written
  // with the recruiter's own User id. The raw/old/new passwords are never stored
  // in the audit metadata — only the fact of the change.
  RECRUITER_PASSWORD_CHANGE
  // Recruiter Team / User management (SRS §4.9). INVITED/REVOKED/ROLE_CHANGED/
  // PERMISSIONS_CHANGED/REMOVED are written with the ACTING owner/admin's User
  // id; INVITE_ACCEPTED with the accepting user's id. The raw invite token and
  // any password material are never written to the diff — only the role /
  // permission deltas and the target's identity.
  RECRUITER_USER_INVITED
  RECRUITER_INVITE_REVOKED
  RECRUITER_INVITE_ACCEPTED
  RECRUITER_USER_ROLE_CHANGED
  RECRUITER_USER_PERMISSIONS_CHANGED
  RECRUITER_USER_REMOVED
  // Recruiter Plans & Billing (SRS §4.11 / §7). PROFILE_UPDATE / ORDER_CREATED
  // are written with the acting owner/admin's User id; SUBSCRIPTION_ACTIVATED
  // and PAYMENT_FAILED with the order's createdBy id (webhook deliveries have
  // no session). No card / payment-instrument data is ever written to the
  // diff — only plan identity, order ids, and amounts.
  BILLING_PROFILE_UPDATE
  BILLING_ORDER_CREATED
  BILLING_SUBSCRIPTION_ACTIVATED
  BILLING_PAYMENT_FAILED
  // Recruiter Help & Support. Written with the reviewing ADMIN's User id when
  // support staff moves a ticket through its lifecycle. Ticket create/reply
  // need no audit action — the SupportTicket / SupportTicketMessage rows are
  // the record. Never write message bodies to the diff — only ids + statuses.
  SUPPORT_TICKET_STATUS_CHANGED
}

// SRS §4.9 — legal / organisational classification of an employer, shown on the
// recruiter-managed company profile and (later) filterable on the public
// directory. Indian-market value set; nullable so existing companies are
// unaffected until a recruiter sets it.
enum CompanyType {
  STARTUP
  INDIAN_MNC
  FOREIGN_MNC
  PRIVATE
  PUBLIC
  GOVERNMENT_PSU
  NGO_NONPROFIT
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
}

// Recruiter "Company Verification" (KYC) state machine — see CompanyKyc.
// NOT_SUBMITTED is the implicit initial state (also represented by the absence
// of a CompanyKyc row). PENDING once the recruiter submits, then an admin moves
// it to VERIFIED or REJECTED. The recruiter portal surfaces the last three as
// the status badge (Pending / Verified / Rejected).
enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

// The two document classes a recruiter uploads for company verification:
// the business registration proof (Certificate of Incorporation / GST
// registration certificate / Udyam, etc.) and the authorized signatory's
// personal ID proof. Stored privately in R2 (signed-URL served, never public).
enum KycDocumentType {
  BUSINESS_REGISTRATION
  AUTHORIZED_PERSON_ID
}

// Recruiter in-app notification kinds (the bell). Phase-1 set covers the events
// with a real producer today: a new application on one of the recruiter's jobs,
// and an admin decision on the company's verification (KYC). "Message" is
// deliberately omitted — there is no recruiter↔candidate messaging feature yet,
// so it would be a dead type. Add new values here behind a migration.
enum NotificationType {
  NEW_APPLICATION
  KYC_VERIFIED
  KYC_REJECTED
  // Help & Support: support staff replied to / changed the status of one of the
  // recruiter's tickets (linkUrl points at /support/tickets/:id).
  SUPPORT_TICKET_UPDATED
  // Job Detail → Collaborate: a job owner added this recruiter as a collaborator
  // (linkUrl points at /jobs/:id).
  JOB_COLLABORATION
  // Admin job moderation (moderation.jobs.enabled). An admin approved a posting
  // that was waiting in PENDING_MODERATION, or sent it back to DRAFT with a
  // reason. One value per outcome, mirroring the KYC_VERIFIED/KYC_REJECTED
  // split rather than a single generic JOB_MODERATED. linkUrl → /jobs/:id.
  JOB_APPROVED
  JOB_REJECTED
}

// SRS §4.9 — recruiter Team / User-management in-company role (RBAC). This is
// the WITHIN-a-company role and is DELIBERATELY separate from the platform-wide
// UserRole (CANDIDATE/RECRUITER/ADMIN): every teammate is still a
// User{role:RECRUITER}; companyRole distinguishes who may manage the team.
// OWNER = full control incl. the team + billing (sole role that can't be removed
// while it's the last one); ADMIN = manage Members (invite/edit/remove) but not
// Owners/other Admins and can't grant OWNER; MEMBER = no team-management rights,
// module access driven by their permission map. Do NOT overload UserRole for
// this — conflating them would break candidate/admin auth.
enum RecruiterRole {
  OWNER
  ADMIN
  MEMBER
}

// Recruiter Help & Support ticket lifecycle. OPEN on creation; support staff
// moves it to IN_PROGRESS / RESOLVED from the admin console; CLOSED is terminal
// (set by staff, or by the recruiter closing their own ticket). A recruiter
// reply to a RESOLVED ticket reopens it to IN_PROGRESS (service-enforced).
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// What a support ticket is about — drives admin triage. Mirrors the portal's
// module split (account / jobs / applicants / verification / billing) plus a
// technical bucket and a catch-all.
enum SupportTicketCategory {
  ACCOUNT
  JOB_POSTING
  APPLICANTS
  VERIFICATION
  BILLING
  TECHNICAL
  OTHER
}

// ============================================================
// User & profile (SRS §8.2)
// ============================================================

model User {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  passwordHash  String? // null for OAuth-only users (no local password) — SRS §4.12.6
  name          String
  phone         String?
  image         String? // avatar URL from an OAuth provider (e.g. Google), optional
  emailVerified Boolean      @default(false)
  role          UserRole     @default(CANDIDATE)
  provider      AuthProvider @default(LOCAL) // auth method — SRS §4.12.6
  googleId      String?      @unique // Google "sub" claim; null for non-Google
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  candidate           Candidate?
  recruiter           Recruiter?
  applications        Application[]
  savedJobs           SavedJob[]
  jobAlerts           JobAlert[]
  subscriptions       Subscription[]
  entitlements        UserEntitlement[]
  usageRecords        UsageRecord[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  profileAuditLogs    ProfileAuditLog[]
  emailPreference     EmailPreference?
  companyReviews      CompanyReview[]
  postedJobs          Job[]                @relation("PostedJobs")
  // Jobs this user was added to as a collaborator (SRS §4.9 Job Detail →
  // Collaborate). Owner link is postedJobs above; this is the allowlist side.
  collaboratingJobs   JobCollaborator[]    @relation("CollaboratingJobs")
  // Recruiter notifications (the bell feed) + recruiter-scoped channel toggles.
  // Both keyed by User id (a recruiter is a User with role RECRUITER); the
  // candidate-shared EmailPreference above is left untouched.
  notifications                   Notification[]
  recruiterNotificationPreference RecruiterNotificationPreference?
  // Recruiter billing — orders this user initiated (owner/admin on the company).
  paymentOrders                   PaymentOrder[]
  // Help & Support — tickets this user raised; contact messages keep a loose
  // (SetNull) link so the inbound record survives account deletion.
  supportTickets         SupportTicket[]
  supportContactMessages SupportContactMessage[]

  @@index([role])
}

// Active refresh-token sessions per SRS §4.12.9.
// refreshTokenHash = sha256(jti) — the raw token never lives in the DB.
model Session {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  deviceInfo       String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// One-time password-reset tokens per SRS §4.12.5.
// tokenHash = sha256(raw) — the raw token only lives in the email body.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Candidate {
  id                     Int              @id @default(autoincrement())
  userId                 Int              @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  summary                String?
  // SRS §4.3.1 — store experience in months for sub-year precision.
  experienceMonths       Int?
  currentTitle           String?
  currentCompanyId       Int?
  currentCompany         Company?         @relation(fields: [currentCompanyId], references: [id], onDelete: SetNull)
  currentSalaryPaise     Int?
  expectedSalaryMinPaise Int?
  expectedSalaryMaxPaise Int?
  noticePeriodDays       Int?
  preferredCityIds       Int[]
  skillIds               Int[]
  // Onboarding-wizard job preferences (SRS §4.3). Scalar enum arrays, empty by
  // default. The WorkMode / EmploymentType enums are shared with the Job model.
  preferredWorkModes     WorkMode[]       @default([])
  preferredJobTypes      EmploymentType[] @default([])
  // Onboarding "Employment & Professional" step (SRS §4.3). Current company/city
  // are free text (no catalogue link at onboarding); industry links to the
  // catalogue. workStatus drives whether the work-experience block renders.
  workStatus             WorkStatus?
  lookingFor             LookingFor?
  currentCompanyName     String?
  currentCityName        String?
  industryId             Int?
  industry               Industry?        @relation(fields: [industryId], references: [id], onDelete: SetNull)
  gender                 Gender?
  // Active resume points to the latest CLEAN row in Resume; older rows stay
  // for audit but are never returned by GET /me/resume.
  activeResumeId         Int?             @unique
  activeResume           Resume?          @relation("ActiveResume", fields: [activeResumeId], references: [id], onDelete: SetNull)
  // SRS §4.3.7 — denormalised completeness score (0–100), recomputed on every
  // PATCH so the UI hot path is one row read.
  profileCompleteness    Int              @default(0)
  profileViews           Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  educations  Education[]
  experiences WorkExperience[]
  projects    Project[]
  languages   CandidateLanguage[]
  resumes     Resume[]            @relation("CandidateResumes")

  @@index([currentCompanyId])
  @@index([industryId])
}

model Education {
  id           Int       @id @default(autoincrement())
  candidateId  Int
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institute    String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
}

model WorkExperience {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyName String
  title       String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

// SRS §4.3 — candidate portfolio projects shown on the profile. techStack is a
// lightweight String[] (free text, no Skill FK) so onboarding stays frictionless.
model Project {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  techStack   String[]  @default([])
  url         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

// SRS §4.3 — languages the candidate knows + self-rated proficiency. Unique per
// (candidate, name) so the same language can't be added twice.
model CandidateLanguage {
  id          Int                 @id @default(autoincrement())
  candidateId Int
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  proficiency LanguageProficiency
  createdAt   DateTime            @default(now())

  @@unique([candidateId, name])
  @@index([candidateId])
}

// SRS §4.3.4 — uploaded resume metadata. The actual file lives in R2 keyed by
// r2Key; the row carries the bookkeeping (size, MIME, scan state). Soft-delete
// via deletedAt so audit trails survive supersede-on-new-upload.
model Resume {
  id               Int              @id @default(autoincrement())
  candidateId      Int
  candidate        Candidate        @relation("CandidateResumes", fields: [candidateId], references: [id], onDelete: Cascade)
  r2Key            String           @unique
  originalFilename String
  sizeBytes        Int
  mimeType         String
  scanStatus       ResumeScanStatus @default(PENDING)
  uploadedAt       DateTime         @default(now())
  deletedAt        DateTime?

  activeOnCandidate Candidate? @relation("ActiveResume")

  @@index([candidateId, deletedAt])
}

// SRS §4.3.6 — every profile edit (incl. single-field PATCHes). Diff is a
// before/after object at field level; a missing key means "not changed".
// Distinct from FlagAuditLog (admin-side feature-flag toggles).
model ProfileAuditLog {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ProfileAuditAction
  diff      Json
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
}

model Recruiter {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         Int
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  designation       String?
  // SRS §4.9.1 — recruiter-editable profile fields (recruiter portal). All
  // nullable: registration only captures name + Email ID + company, the rest is
  // filled in later from the Profile tab.
  department        String?
  contactPhone      String?
  // Alternate point of contact — a backup person for this recruiter's company
  // (e.g. the hiring manager). Captured as discrete fields so the email/phone
  // can be validated and surfaced as a proper contact card.
  altPocName        String?
  altPocEmail       String?
  altPocPhone       String?
  // Registration captures a single "Email ID" (the User.email login
  // identifier); there is no separate work-email column anymore. The flag
  // below still gates job posting: clicking the verification link sent to
  // User.email establishes the recruiter controls that mailbox. Admin still
  // verifies the recruiter↔company association before any job-post can land
  // (Task 16 + Task 17). Kept the `workEmailVerified` name to avoid colliding
  // with User.emailVerified (which feeds the candidate flow + JWT claims).
  workEmailVerified Boolean  @default(false)
  // SRS §4.9 — Team / User management (in-company RBAC). companyRole is the
  // within-company role (see RecruiterRole); DISTINCT from the platform User.role.
  // Defaulted MEMBER; the add_recruiter_team_roles_and_invites migration backfills
  // the earliest recruiter per company to OWNER so every existing team has exactly
  // one owner. permissions is a per-module access map
  // { jobs | applicants | company_profile | verification | notifications | team ->
  // EDIT | READ_ONLY | NONE }; null means "derive from the companyRole defaults".
  companyRole       RecruiterRole @default(MEMBER)
  permissions       Json?
  // Soft-remove for the "Remove user" action: set instead of deleting the row so
  // FK'd data (posted jobs, audit rows) survives. A deactivated recruiter has
  // their sessions revoked and is blocked from re-authenticating until an
  // owner/admin reactivates them.
  deactivatedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, deactivatedAt])
  @@index([workEmailVerified])
}

// SRS §4.9 — recruiter Team invitations. An owner/admin invites a teammate by
// email; the token mirrors PasswordResetToken (sha256(raw) stored here, the raw
// token lives only in the email link) and is single-use, revocable, and listable
// as "Pending" in the Users panel — which a stateless JWT could not be. On accept
// the invitee joins THIS company with the pre-assigned companyRole + permissions.
// Company-scoped; invitedByUserId is the acting recruiter's User id (loose actor,
// no FK — the CompanyKyc.reviewedById pattern). The pending/accepted/revoked/
// expired status is DERIVED from the timestamp columns, not stored. "One active
// invite per (company,email)" is enforced in the service (supersede-on-reinvite),
// not as a Prisma @@unique (the constraint is partial: WHERE accepted/revoked IS
// NULL). Raw tokens/PII are never logged or written to audit JSON.
model RecruiterInvite {
  id              Int           @id @default(autoincrement())
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email           String
  companyRole     RecruiterRole @default(MEMBER)
  permissions     Json?
  tokenHash       String        @unique
  invitedByUserId Int?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, email])
}

// ============================================================
// Company (SRS §8.2)
// ============================================================

model Company {
  id                 Int          @id @default(autoincrement())
  slug               String       @unique
  name               String
  description        String?
  logoUrl            String?
  websiteUrl         String?
  // SRS §4.9 — recruiter-editable organisational classification. Nullable so
  // existing companies are unaffected until a recruiter sets it.
  companyType        CompanyType?
  industryId         Int?
  industry           Industry?    @relation(fields: [industryId], references: [id], onDelete: SetNull)
  headquartersCityId Int?
  headquartersCity   City?        @relation(fields: [headquartersCityId], references: [id], onDelete: SetNull)
  employeeCount      String?
  foundedYear        Int?
  // SRS §4.7.4 — denormalised review aggregates so the directory page renders
  // in one query. Recomputed when reviews are written; the write path lands
  // with the recruiter portal (Task 15).
  averageRating      Float?
  reviewCount        Int          @default(0)
  // SRS §4.7.6 — CMS-managed array of { heading, body, imageUrl? } blocks for
  // the /working-at-{slug} page. Admin tool to edit lands with Task 16.
  workingAtSections  Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  jobs       Job[]
  recruiters Recruiter[]
  candidates Candidate[]
  reviews    CompanyReview[]
  kyc        CompanyKyc?
  invites    RecruiterInvite[]
  // Recruiter Plans & Billing — company-scoped subscription state. A plan
  // bought by an owner/admin entitles the whole recruiter team.
  subscriptions  Subscription[]
  paymentOrders  PaymentOrder[]
  invoices       SubscriptionInvoice[]
  billingProfile CompanyBillingProfile?
  // Help & Support — tickets raised by this company's recruiters (company kept
  // on the ticket for admin context + a possible future team-visible list).
  supportTickets SupportTicket[]

  @@index([industryId])
  @@index([headquartersCityId])
}

// Recruiter "Company Verification" (KYC) — one record per Company (multiple
// recruiters share one Company, so verification is company-level, not
// per-recruiter). Holds the Indian business identifiers + authorized-signatory
// details + the admin-reviewed verification state. Uploaded files live in the
// related KycDocument rows. Sensitive: identifiers are PII (DPDP Act 2023) — do
// not log raw values; documents are served via short-lived signed URLs only.
model CompanyKyc {
  id        Int     @id @default(autoincrement())
  companyId Int     @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Business identifiers. GSTIN (15) / PAN (10) are format-validated at the API
  // boundary; live registry (GSTN/MCA) verification is a Phase-2 follow-up.
  legalName          String?
  gstNumber          String?
  panNumber          String?
  registrationNumber String? // CIN / Udyam / free-text, optional

  // Authorized signatory submitting on the company's behalf.
  authorizedPersonName        String?
  authorizedPersonDesignation String?
  authorizedPersonIdType      String? // PAN | AADHAAR | PASSPORT | VOTER_ID | DRIVING_LICENSE (UI-constrained)

  // Admin-reviewed verification state machine.
  status          KycStatus @default(NOT_SUBMITTED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    Int? // admin User id; nullable, no FK (FlagAuditLog.changedById pattern)
  rejectionReason String?

  documents KycDocument[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

// A single uploaded KYC file. Mirrors the private Resume pattern: the bytes live
// in R2 keyed by r2Key, the row carries the bookkeeping. Soft-delete via
// deletedAt so supersede-on-reupload keeps an audit trail. scanStatus reuses the
// generic malware tristate. The "one active (deletedAt IS NULL) doc per docType
// per company" invariant is enforced in the service: uploadDocument supersedes
// the prior active doc inside a transaction that holds a FOR UPDATE row lock on
// the parent CompanyKyc, serialising concurrent same-type uploads. (It can't be
// a Prisma @@unique — the constraint is partial: WHERE deletedAt IS NULL.)
model KycDocument {
  id               Int              @id @default(autoincrement())
  companyKycId     Int
  companyKyc       CompanyKyc       @relation(fields: [companyKycId], references: [id], onDelete: Cascade)
  docType          KycDocumentType
  r2Key            String           @unique
  originalFilename String
  sizeBytes        Int
  mimeType         String
  scanStatus       ResumeScanStatus @default(PENDING)
  uploadedById     Int // recruiter User id who uploaded
  uploadedAt       DateTime         @default(now())
  deletedAt        DateTime?

  @@index([companyKycId, deletedAt])
}

// SRS §4.7.4 — read-only on the public profile page in this PR. Write paths
// (recruiter approval / candidate submission) come later; the page renders
// rating + count from Company's denormalised fields so it does not scan the
// table on every render.
model CompanyReview {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating     Int
  title      String?
  body       String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, createdAt])
}

// ============================================================
// Job & related (SRS §8.2 — composite indexes mandatory)
// ============================================================

// Post a Job Phase 3 — the posting product/type. FREE + INTERNSHIP are always
// available; HOT_VACANCY + SMB are paid (gated OFF on Day 0). Distinct from
// EmploymentType (which stays the full/part/contract/intern axis).
enum JobType {
  FREE
  HOT_VACANCY
  SMB
  INTERNSHIP
}

model Job {
  id                 Int             @id @default(autoincrement())
  canonicalSlug      String          @unique
  title              String
  description        String
  // Post a Job Phase 4 — rich JD as Markdown (rendered sanitized on the seeker
  // side via the article pipeline). Nullable: existing jobs keep the plain-text
  // `description` render, so this is zero-regression.
  descriptionMarkdown String?
  shortDescription   String?
  companyId          Int
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // SRS §4.9.3 — recruiter ownership. SetNull on the FK so a recruiter
  // departure does not cascade-delete their jobs (admin reassigns later).
  postedById         Int?
  postedBy           User?           @relation("PostedJobs", fields: [postedById], references: [id], onDelete: SetNull)
  primaryCityId      Int?
  primaryCity        City?           @relation(fields: [primaryCityId], references: [id], onDelete: SetNull)
  // Post a Job Phase 3 — optional sub-city area/locality (City → Area selector).
  // SetNull so pruning a locality doesn't delete jobs.
  localityId         Int?
  locality           Locality?       @relation(fields: [localityId], references: [id], onDelete: SetNull)
  cityIds            Int[]
  skillIds           Int[]
  industryId         Int?
  industry           Industry?       @relation(fields: [industryId], references: [id], onDelete: SetNull)
  functionalAreaId   Int?
  functionalArea     FunctionalArea? @relation(fields: [functionalAreaId], references: [id], onDelete: SetNull)
  status             JobStatus       @default(ACTIVE)
  // SRS §4.9.3 wizard step 5 — defaults match the most common case so a
  // recruiter who skips the step still ships a sensible JSON-LD payload.
  employmentType     EmploymentType  @default(FULL_TIME)
  workMode           WorkMode        @default(ONSITE)
  // Post a Job Phase 3 — posting product/type. Default so existing rows backfill to FREE.
  jobType            JobType         @default(FREE)
  // postedAt means "reached the market", NOT "the row was created" — publish()
  // refreshes it at go-live, and under moderation the approve path refreshes it
  // again at APPROVAL, because that is when a seeker can first see the job.
  // (It is NOT NULL DEFAULT now(), so a DRAFT carries one too — do not treat a
  // non-null postedAt as proof a job was ever live.)
  postedAt           DateTime        @default(now())
  expiresAt          DateTime?
  // Admin job moderation (moderation.jobs.enabled). All four are null for a job
  // that never went through review, so they are additive and backfill-free.
  //   submittedForReviewAt — set when the job ENTERS PENDING_MODERATION, and the
  //     column the review queue sorts on. It is NOT interchangeable with
  //     postedAt: reopen() puts a previously-live job back into review without
  //     touching postedAt, so a job reopened today can carry a postedAt from
  //     months ago and would jump an oldest-first queue ordered on it. It is
  //     also the only surviving record of the wait once approval moves postedAt
  //     to the go-live moment (reviewedAt − submittedForReviewAt).
  //   reviewedAt / reviewedById — who decided, and when. reviewedById is a loose
  //     User id with no FK, matching CompanyKyc.reviewedById: a deleted admin
  //     must not cascade into job rows or block the delete.
  //   rejectionReason — the admin's note, surfaced to the recruiter. Cleared on
  //     approve and on re-publish, so it always describes the CURRENT state.
  //   postQuotaConsumed — whether a post-quota slot was actually spent to put
  //     this job into review. create(PUBLISH) and publish() consume one;
  //     reopen() deliberately does not, because relisting an existing job is not
  //     posting a new one. A rejection refunds the slot, so without this flag it
  //     would refund one that was never taken and reopen → reject would mint a
  //     free post. Cleared whenever the job leaves PENDING_MODERATION.
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewedById         Int?
  rejectionReason      String?
  postQuotaConsumed    Boolean   @default(false)
  salaryMinPaise     Int?
  salaryMaxPaise     Int?
  experienceMinYears Int?
  experienceMaxYears Int?
  // Post a Job Phase 3 — rich Job Details form fields (all additive/nullable).
  openings           Int?
  qualifications     String?
  internshipDurationMonths Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  applications  Application[]
  savedBy       SavedJob[]
  collaborators JobCollaborator[]

  @@index([status, postedAt])
  // Backs the admin review queue: WHERE status='PENDING_MODERATION'
  // ORDER BY submittedForReviewAt. @@index([status, postedAt]) cannot serve it —
  // see the submittedForReviewAt comment for why the two columns diverge.
  @@index([status, submittedForReviewAt])
  @@index([primaryCityId, status])
  @@index([companyId, status])
  @@index([postedById, status])
}

// SRS §4.9 — Job Detail "Collaborate": teammates a job's owner grants access to
// so they can help manage (edit / close-reopen) or respond (act on applicants).
// A job's single OWNER is Job.postedById; collaborators are an additive allowlist
// on top, keyed by User id (matching postedById + JWT sub) so the owner-or-
// collaborator access check is a plain OR across the two. Destructive/make-live
// actions (delete, publish) + managing collaborators themselves stay owner-only.
// addedById is the acting owner's User id (loose actor, SetNull on their removal —
// the RecruiterInvite.invitedByUserId pattern). Rows cascade-delete with the job
// or the collaborating user.
model JobCollaborator {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("CollaboratingJobs", fields: [userId], references: [id], onDelete: Cascade)
  addedById Int?
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}

model Application {
  id             Int               @id @default(autoincrement())
  userId         Int
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          Int
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @default(APPLIED)
  resumeUrl      String?
  coverLetter    String?
  statusHistory  Json?
  // SRS §4.9.6 — recruiter-only freeform notes. Single field for MVP; a
  // multi-note timestamped audit trail is queued as a follow-up chip.
  recruiterNotes String?
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId, status])
}

model SavedJob {
  userId  Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId   Int
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@id([userId, jobId])
  @@index([jobId])
}

model JobAlert {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  query            Json
  // 'instant' | 'daily' | 'weekly' — kept as string for forward-compat with
  // future cadences (e.g. 'every-other-day') without a schema migration.
  frequency        String    @default("daily")
  isActive         Boolean   @default(true)
  lastRunAt        DateTime?
  // SRS §4.5.4 — dedupe state. Worker stores the job ids it last emailed for
  // this alert; on each run, only ids NOT in this set count as "new".
  lastSentJobIds   Int[]     @default([])
  lastSentAt       DateTime?
  // SRS §4.5.6 — high-entropy token used by the one-click unsubscribe link in
  // every alert email. Random per-alert so leaking one token does not unlock
  // the user's other alerts. Defaulted at the DB layer (gen_random_uuid()) to
  // match the migration and avoid prisma-migrate-diff drift; raw-SQL inserts
  // get the same generation path as Prisma client inserts.
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, isActive])
  @@index([frequency, isActive])
}

// SRS §4.13.4 foundation — per-user channel toggles. Lazily provisioned on
// first read. productNewsEnabled defaults OFF (CLAUDE.md §0 — freemium, no
// marketing surface).
model EmailPreference {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlertsEnabled         Boolean  @default(true)
  applicationStatusEnabled Boolean  @default(true)
  productNewsEnabled       Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// Recruiter-portal in-app notifications (the top-bar bell). One row per alert
// addressed to a recruiter User. Reads (list + unread count) happen in the
// recruiter RSC / a small client poll; mark-read is a BFF mutation. Producers
// write rows fire-and-log at the source events (new application, KYC decision).
// linkUrl is an in-portal relative path the bell links to (e.g.
// /jobs/123/applicants). Kept generic (userId, not recruiterId) so the same
// table can serve any role later — but only recruiter producers + UI exist now.
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Unread-count badge query: WHERE userId = ? AND readAt IS NULL.
  @@index([userId, readAt])
  // Feed query: WHERE userId = ? ORDER BY createdAt DESC.
  @@index([userId, createdAt(sort: Desc)])
}

// Recruiter-scoped notification channel toggles (email on/off, SMS on/off).
// DELIBERATELY separate from the candidate-shared EmailPreference so the
// job-seeker portal's GET/PATCH /me/notifications contract is byte-untouched.
// Lazily provisioned like EmailPreference: a default read returns the schema
// defaults without inserting a row; the first PATCH upserts. SMS delivery is
// deferred (no SMS provider configured yet — Resend is email-only) — the toggle
// is persisted now as the control surface, gating outbound SMS when that lands.
model RecruiterNotificationPreference {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// CMS — career-advice articles (SRS §4.8)
// ============================================================

model Article {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  title           String
  // Markdown source. Rendered to HTML server-side via the unified + remark +
  // rehype + Shiki pipeline at apps/web/lib/cms/markdown.ts.
  body            String
  excerpt         String?
  authorName      String
  status          ArticleStatus @default(DRAFT)
  publishedAt     DateTime?
  readTimeMinutes Int?
  // SRS §4.8 — multi-tag taxonomy. String[] keeps the schema light; a Tag
  // join table lands when we add tag-cloud aggregations (chip).
  tags            String[]      @default([])
  // Optional FAQ block per SRS §4.8.3 — array of { question, answer } pairs.
  // When present, the detail page emits a FAQPage JSON-LD entity in addition
  // to the Article one.
  faqs            Json?
  coverImageUrl   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([tags], type: Gin)
}

// ============================================================
// Reference data (SRS §8 — denormalized lookups)
// ============================================================

model Industry {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  companies  Company[]
  jobs       Job[]
  candidates Candidate[]
}

model FunctionalArea {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  jobs Job[]
}

model City {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())

  jobs        Job[]
  companies   Company[]
  localities  Locality[]
}

// Post a Job Phase 3 — sub-city area/locality, scoped to a City (the second
// level of the City → Area location selector). Curated seed per major city.
model Locality {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  jobs Job[]

  @@index([cityId])
}

model Skill {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  category  String?
  // SRS §4.3 — true when a candidate created this skill by typing a name that
  // wasn't in the seeded catalogue (find-or-create at /me/skills). Lets admins
  // later review/merge user-created skills.
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// Feature flags + audit (SRS §7.4 + CLAUDE.md §4 — flags ship OFF)
// ============================================================

model FeatureFlag {
  id              Int                @id @default(autoincrement())
  key             String             @unique
  description     String?
  uiLabel         String?
  category        String?
  type            FlagType           @default(BOOLEAN)
  enabled         Boolean            @default(false)
  percentage      Int?
  targetUserIds   Int[]
  requiredTiers   SubscriptionTier[]
  cohorts         String[]
  createdById     Int?
  lastChangedById Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  auditLogs FlagAuditLog[]

  @@index([category])
}

model FlagAuditLog {
  id          Int         @id @default(autoincrement())
  flagId      Int
  flag        FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  before      Json
  after       Json
  changedAt   DateTime    @default(now())
  changedById Int?
  reason      String?

  @@index([flagId, changedAt(sort: Desc)])
}

// ============================================================
// Subscriptions & entitlements (SRS §7.4 — plans ship inactive)
// ============================================================

model SubscriptionPlan {
  id             Int              @id @default(autoincrement())
  slug           String           @unique
  name           String
  description    String?
  tier           SubscriptionTier
  // Storefront audience. Default CANDIDATE matches the original seeded plans;
  // the add_recruiter_billing migration backfills enterprise-yearly (a
  // recruiter-team plan) to RECRUITER.
  audience       PlanAudience     @default(CANDIDATE)
  priceInPaise   Int
  currency       String           @default("INR")
  intervalDays   Int
  trialDays      Int?
  featureKeys    String[]
  isActive       Boolean          @default(false)
  isPublic       Boolean          @default(false)
  sortOrder      Int              @default(0)
  stripePriceId  String?          @unique
  razorpayPlanId String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscriptions Subscription[]
  paymentOrders PaymentOrder[]

  @@index([audience, isActive, isPublic])
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Recruiter subscriptions are company-scoped: a plan bought by an owner/
  // admin entitles the whole team (see resolveRecruiterTier in apps/api).
  // Null for candidate subscriptions — userId stays the sole scope there.
  companyId              Int?
  company                Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId                 Int
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus @default(TRIALING)
  startedAt              DateTime           @default(now())
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelReason           String?
  stripeSubscriptionId   String?            @unique
  razorpaySubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices SubscriptionInvoice[]

  @@index([userId, status])
  @@index([companyId, status])
  @@index([planId])
}

// Recruiter billing extended this from the original bare skeleton into a
// GST-compliant invoice record (CGST Rule 46): consecutive FY-scoped invoice
// number, taxable/CGST/SGST/IGST breakup, a frozen buyer snapshot, and the
// private R2 key of the rendered PDF (signed-URL served, never public).
// companyId/paymentOrderId stay nullable so the model can still serve future
// candidate-side invoicing.
model SubscriptionInvoice {
  id                Int           @id @default(autoincrement())
  subscriptionId    Int
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  companyId         Int?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  paymentOrderId    Int?          @unique
  paymentOrder      PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  invoiceNumber     String?       @unique // consecutive per Indian FY, e.g. INV-2627-000001
  amountInPaise     Int // grand total actually charged (GST-inclusive)
  taxableInPaise    Int? // pre-tax value (amount − GST)
  cgstInPaise       Int?
  sgstInPaise       Int?
  igstInPaise       Int?
  gstRateBps        Int? // 1800 = 18%
  placeOfSupply     String? // buyer state (GST place of supply)
  buyerSnapshot     Json? // frozen { legalName, gstin?, address, state, ... } at issue time
  // Line-item facts frozen at issuance so the statutory document never drifts:
  // the plan name survives a later admin rename, and the period is the window
  // THIS payment bought (a renewal stores the extension window, not the live
  // subscription span). Rendered in preference to the live subscription rows.
  planNameSnapshot  String?
  periodStart       DateTime?
  periodEnd         DateTime?
  pdfKey            String? // private R2 key of the rendered PDF
  currency          String        @default("INR")
  status            InvoiceStatus
  providerInvoiceId String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([subscriptionId])
  @@index([companyId, createdAt(sort: Desc)])
}

// One row per Razorpay Checkout attempt (Orders API). The order is created
// server-side with the plan's DB price — never a client-supplied amount. The
// webhook (payment.captured / order.paid) is the activation source of truth,
// with the browser verify callback as a faster duplicate path — both funnel
// into one idempotent activation keyed on this row (FOR UPDATE lock).
// razorpayOrderId is "order_stub_*" when the gateway runs in the keyless
// local-dev stub mode (RAZORPAY_KEY_ID blank).
model PaymentOrder {
  id                Int                @id @default(autoincrement())
  companyId         Int
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUserId   Int
  createdBy         User               @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  planId            Int
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  amountInPaise     Int
  currency          String             @default("INR")
  status            PaymentOrderStatus @default(CREATED)
  razorpayOrderId   String             @unique
  razorpayPaymentId String?            @unique
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  invoice SubscriptionInvoice?

  @@index([companyId, createdAt(sort: Desc)])
  @@index([status])
}

// Idempotency ledger for provider webhooks (CLAUDE.md §3.2: signature-verified,
// idempotent). One row per delivered event id; the unique constraint turns
// replayed / duplicate deliveries into no-ops. Payload kept for audit and
// debugging — Razorpay events carry payment metadata only, never card data.
model PaymentWebhookEvent {
  id          Int       @id @default(autoincrement())
  provider    String    @default("razorpay")
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType, createdAt(sort: Desc)])
}

// Billing identity for GST-compliant invoices — one per company, collected
// before the first purchase and editable from /billing. Deliberately separate
// from CompanyKyc (verification evidence) though the form prefills from it.
// state drives the CGST+SGST vs IGST split against BILLING_SELLER_STATE.
model CompanyBillingProfile {
  id           Int      @id @default(autoincrement())
  companyId    Int      @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName    String
  gstin        String? // buyer GSTIN — printed on the invoice when registered (B2B)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String // Indian state/UT from the shared constant list
  pincode      String
  billingEmail String? // invoice recipient override; falls back to the purchaser's email
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserEntitlement {
  id         Int               @id @default(autoincrement())
  userId     Int
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String
  source     EntitlementSource
  expiresAt  DateTime?
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@unique([userId, featureKey])
  @@index([featureKey])
}

model UsageRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureKey String
  quantity   Int      @default(1)
  occurredAt DateTime @default(now())
  metadata   Json?

  @@index([userId, featureKey, occurredAt])
}

// ============================================================
// Recruiter Help & Support (tickets + contact messages)
// ============================================================

// A tracked support issue raised by a recruiter (Help & Support → Raise a
// ticket). Creator-scoped: the raising recruiter sees + replies to their own
// tickets; support staff (ADMIN) work the queue in /admin/support. The initial
// problem statement lives in `description`; the back-and-forth lives in
// SupportTicketMessage rows.
model SupportTicket {
  id          Int                   @id @default(autoincrement())
  userId      Int
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Company kept for admin context (which employer is asking) — the ticket
  // itself stays creator-scoped, mirroring "user-owned rows" everywhere else.
  companyId   Int
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subject     String
  description String
  category    SupportTicketCategory
  status      SupportTicketStatus   @default(OPEN)
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages SupportTicketMessage[]

  // "My tickets" list: WHERE userId = ? ORDER BY createdAt DESC.
  @@index([userId, createdAt(sort: Desc)])
  // Admin queue: filter by status, newest first.
  @@index([status, createdAt(sort: Desc)])
  @@index([companyId])
}

// One message in a ticket's thread. authorId is a loose User id (no FK — same
// pattern as CompanyKyc.reviewedById): the raising recruiter for their own
// replies, the admin's id when fromSupport is true. Bodies are user content —
// never copied into audit diffs or logs.
model SupportTicketMessage {
  id          Int           @id @default(autoincrement())
  ticketId    Int
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    Int
  fromSupport Boolean       @default(false)
  body        String
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// A one-off "Contact Us" submission (Help & Support → Contact us). The durable
// record — the ops-inbox email is best-effort fire-and-log on top. userId is
// the signed-in recruiter, SetNull so the inbound record outlives the account;
// name/email are the submitted form values (prefilled from the session but
// editable).
model SupportContactMessage {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
