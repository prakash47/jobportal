{
  "name": "@jobportal/search",
  "version": "0.1.0",
  "private": true,
  "description": "Elasticsearch 9 client, index mappings, indexers, and search query helpers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "echo 'no lint configured yet'",
    "typecheck": "tsc --noEmit",
    "search:bootstrap": "tsx scripts/bootstrap.ts",
    "search:reindex": "tsx scripts/reindex.ts",
    "search:seed-fixtures": "tsx scripts/seed-fixtures.ts",
    "search:benchmark": "tsx scripts/benchmark.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.0.0",
    "@jobportal/db": "workspace:*",
    "@jobportal/types": "workspace:*",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
