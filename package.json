{
  "name": "jobportal",
  "version": "0.1.0",
  "description": "India-focused job-search and recruitment platform.",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "@nestjs/core",
      "argon2"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @jobportal/db db:generate",
    "db:migrate": "pnpm --filter @jobportal/db db:migrate",
    "db:migrate:dev": "pnpm --filter @jobportal/db db:migrate:dev",
    "db:seed": "pnpm --filter @jobportal/db db:seed",
    "db:studio": "pnpm --filter @jobportal/db db:studio",
    "db:reset": "pnpm --filter @jobportal/db db:reset",
    "search:bootstrap": "pnpm --filter @jobportal/search search:bootstrap",
    "search:reindex": "pnpm --filter @jobportal/search search:reindex",
    "search:seed-fixtures": "pnpm --filter @jobportal/search search:seed-fixtures",
    "search:benchmark": "pnpm --filter @jobportal/search search:benchmark"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "globals": "^17.12.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  }
}
