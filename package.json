{
  "name": "jobportal",
  "version": "0.1.0",
  "description": "India-focused job-search and recruitment platform.",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "@nestjs/core"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @jobportal/db db:generate",
    "db:migrate": "pnpm --filter @jobportal/db db:migrate",
    "db:migrate:dev": "pnpm --filter @jobportal/db db:migrate:dev",
    "db:seed": "pnpm --filter @jobportal/db db:seed",
    "db:studio": "pnpm --filter @jobportal/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.0"
  }
}
