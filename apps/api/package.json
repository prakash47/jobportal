{
  "name": "@jobportal/api",
  "version": "0.1.0",
  "private": true,
  "description": "JobPortal — NestJS BFF for all clients.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@jobportal/auth": "workspace:*",
    "@jobportal/db": "workspace:*",
    "@jobportal/feature-flags": "workspace:*",
    "@jobportal/search": "workspace:*",
    "@jobportal/types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "bullmq": "^5.76.6",
    "cookie-parser": "^1.4.7",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.12.3",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
