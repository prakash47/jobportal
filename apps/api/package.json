{
  "name": "@jobportal/api",
  "version": "0.1.0",
  "private": true,
  "description": "JobPortal — NestJS BFF for all clients.",
  "scripts": {
    "build": "nest build",
    "dev": "node -r @swc-node/register src/main.ts",
    "start": "node -r @swc-node/register dist/apps/api/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@jobportal/auth": "workspace:*",
    "@jobportal/db": "workspace:*",
    "@jobportal/domain": "workspace:*",
    "@jobportal/feature-flags": "workspace:*",
    "@jobportal/observability": "workspace:*",
    "@jobportal/search": "workspace:*",
    "@jobportal/types": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.53.0",
    "@sentry/node": "^10.53.0",
    "bullmq": "^5.76.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.0",
    "ioredis": "^5.5.0",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.12.3",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "jsonwebtoken": "^9.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
