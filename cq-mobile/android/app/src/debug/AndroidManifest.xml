<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext for debug builds is granted by
         src/debug/res/xml/network_security_config.xml, which overrides the
         strict release policy in src/main for this variant only.

         `android:usesCleartextTraffic` is deliberately NOT set here: Android
         ignores that attribute whenever android:networkSecurityConfig is
         present (which it is, from the main manifest), so it would be dead
         config that looks protective. The XML file is the single source of
         truth for this.
    -->
</manifest>
