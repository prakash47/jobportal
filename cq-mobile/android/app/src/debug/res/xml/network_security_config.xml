<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY override. Same resource name as the one in src/main, so Gradle's
  resource merging swaps this in for debug builds and leaves release builds on
  the strict policy.

  Permissive on purpose: development often points the app at a LAN address (via
  the API_BASE_URL dart-define, e.g. http://192.168.1.7:4000) so a phone on the
  same Wi-Fi can reach the dev machine, and those hosts cannot be enumerated
  ahead of time. This file never ships; a release build does not include it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
