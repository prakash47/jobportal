<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Career Queue</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Career Queue</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Portrait only. Every screen in this app was designed and reviewed at
		     phone width; nothing was laid out for landscape, and the iPad entry
		     additionally promised a tablet experience that does not exist. Apple
		     reviews what the app DECLARES, so declaring landscape and iPad
		     invites a rejection for a layout nobody built. Widen this the day
		     the layouts exist, not before. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- The app never opens the photo library or the media library: a resume
		     is attached through the Files document picker (FileType.custom).
		     These strings are here because file_picker's public header imports
		     <Photos/Photos.h> and <MediaPlayer/MediaPlayer.h> unguarded, so the
		     binary references those APIs and Apple's upload check (ITMS-90683)
		     rejects a build that declares no purpose for them. The wording is
		     written for the reviewer who reads it, and is true. Stripping the
		     picker's media code via Pod::PICKER_MEDIA=false in a Podfile is the
		     cleaner fix, but it cannot be verified without a Mac, and it would
		     not remove these two imports anyway, only the PhotosUI one. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Career Queue does not read your photo library. You attach a resume from Files. This entry is required because the file picker the app bundles links Apple's photo APIs.</string>
		<key>NSAppleMusicUsageDescription</key>
		<string>Career Queue does not access your media library. This entry is required because the file picker the app bundles links Apple's media APIs.</string>
		<!-- The app speaks only HTTPS, which is exempt encryption. Declaring it
		     here stops every single upload stalling on the export-compliance
		     questionnaire. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
