# Database
DATABASE_URL="postgresql://jobportal:jobportal@localhost:5432/jobportal_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-replace-me"
JWT_REFRESH_SECRET="dev-refresh-secret-replace-me"

# Email (Resend) — leave blank locally; emails log to console (no-op stub).
# Set RESEND_API_KEY to actually deliver mail (verification links, etc.).
RESEND_API_KEY=""
# Sender address. Resend only delivers if `from` is the shared test sender
# (onboarding@resend.dev — delivers ONLY to your own Resend-account email) or
# an address on a domain you've verified in Resend. Defaults in code to
# "JobPortal <noreply@jobportal.com>" (unverified — will be rejected).
RESEND_FROM="JobPortal <onboarding@resend.dev>"

# Cloudflare R2 — leave blank locally; uploads can use a local dev folder
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jobportal-dev"
# Public base URL for PERMANENTLY-public assets (company logos rendered on the
# public site, cached by Cloudflare). In prod set to your CDN / R2 public domain
# (e.g. https://cdn.jobportal.com) — it must be whitelisted in each Next app's
# next.config images.remotePatterns. Leave BLANK locally: the API then serves
# logos from its own /media passthrough (http://localhost:4000/media/...) so
# uploads still render in dev. Public logos are never signed/expiring.
R2_PUBLIC_URL=""

# Stripe — Phase 2 only, leave blank for now
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry / PostHog — optional locally. Blank values produce zero events.
# Server-side (API + RSC/instrumentation in Next)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Browser-side. Same DSN/key is safe to expose — these are public ingest
# tokens. They MUST be NEXT_PUBLIC_-prefixed so Next inlines them into
# the client bundle.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Build-time sourcemap upload (set in CI; blank locally). Used by the
# @sentry/nextjs webpack plugin during `next build`.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# App URLs (for cross-app links + CORS)
WEB_URL="http://localhost:3000"
RECRUITER_URL="http://localhost:3001"
SERVICES_URL="http://localhost:3002"
API_URL="http://localhost:4000"

# Web → API base URL (browser-side; used for auth fetches + the Google button
# target). Falls back to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Google OAuth (SRS §4.12.6, ADR 0001) — leave blank locally; the "Continue
# with Google" buttons stay hidden and the /auth/google routes 404 until all
# three are set. Create a Web-application OAuth client at
# https://console.cloud.google.com → APIs & Services → Credentials, and add the
# redirect URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Cookie domain — blank locally (host-only on localhost). In production set to a
# shared parent (e.g. .yourdomain.com) so the cookie the API origin sets is
# readable by the web origin across subdomains.
COOKIE_DOMAIN=""
