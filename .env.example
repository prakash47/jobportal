# ============================================================
# JobPortal — Environment variables template
# ============================================================
# 1. Copy this file to `.env` (gitignored)        →  cp .env.example .env
# 2. Replace placeholder values with real secrets
# 3. NEVER commit `.env` or any `.env.*.local` file
#
# Per-app overrides can live in `apps/<app>/.env.local`
# ============================================================


# -------- App URLs (used for CORS, redirects, cross-app links) --------
WEB_URL="http://localhost:3000"
RECRUITER_URL="http://localhost:3001"
SERVICES_URL="http://localhost:3002"
API_URL="http://localhost:4000"

NODE_ENV="development"


# -------- Database (PostgreSQL 18) --------
# Local dev uses the docker-compose Postgres at infra/docker-compose.yml
DATABASE_URL="postgresql://jobportal:jobportal@localhost:5432/jobportal_dev"

# Optional: separate read replica URL (Phase 2+)
# DATABASE_REPLICA_URL=""


# -------- Cache & queues (Redis 8) --------
REDIS_URL="redis://localhost:6379"


# -------- Search (Elasticsearch 9) --------
ELASTICSEARCH_URL="http://localhost:9200"
# Production ES typically requires auth — set these when deploying
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
# ELASTICSEARCH_API_KEY=""


# -------- Auth (JWT + Argon2id) --------
# Generate with:  openssl rand -base64 48
# These MUST be different secrets, and rotated on any suspected compromise
JWT_ACCESS_SECRET="dev-access-secret-replace-me-with-openssl-rand-base64-48"
JWT_REFRESH_SECRET="dev-refresh-secret-replace-me-with-openssl-rand-base64-48"

# Token TTLs (seconds). Defaults match SRS §4.12.
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days

# Cookie domain — leave blank locally; set to ".jobportal.com" in production
COOKIE_DOMAIN=""


# -------- Object storage (Cloudflare R2 — S3-compatible) --------
# Locally you can leave these blank; uploads will fall back to ./uploads/ in dev
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jobportal-dev"
R2_PUBLIC_URL=""                    # e.g. https://cdn.jobportal.com


# -------- Email (Resend) --------
# Leave blank locally — emails will be logged to console instead of sent
RESEND_API_KEY=""
EMAIL_FROM="JobPortal <noreply@jobportal.com>"
EMAIL_REPLY_TO="support@jobportal.com"


# -------- Payments (Stripe) — Phase 2 only --------
# Leave blank during Phase 1; subscription system ships dark
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (alternative provider for Indian market)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""


# -------- Observability --------
# Sentry — error + performance monitoring
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# PostHog — product analytics + RUM
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Public-facing keys (exposed to browser — no secrets here)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"


# -------- Rate limiting (NestJS Throttler) --------
RATE_LIMIT_PUBLIC_PER_MIN="100"
RATE_LIMIT_AUTH_PER_MIN="1000"
RATE_LIMIT_RESDEX_PER_MIN="10"


# -------- File upload limits --------
RESUME_MAX_BYTES="5242880"          # 5 MB
RESUME_ALLOWED_MIME="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
LOGO_MAX_BYTES="2097152"            # 2 MB
CLAMAV_HOST=""                      # leave blank locally; required in prod
CLAMAV_PORT="3310"


# -------- Feature flag defaults (overridable per environment) --------
# These don't replace the database flag system — they're fallback constants
# the app reads on cold start before the DB cache warms up
FLAGS_DEFAULT_ON="false"
FLAGS_REDIS_TTL_SECONDS="30"


# -------- OAuth (Phase 2 — Google + LinkedIn) --------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""


# -------- Misc --------
# Public-facing app version (for Sentry release tagging, telemetry)
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Set to "true" to enable verbose Prisma query logging in dev
PRISMA_LOG_QUERIES="false"
