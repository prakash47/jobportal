# Database
DATABASE_URL="postgresql://jobportal:jobportal@localhost:5432/jobportal_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-replace-me"
JWT_REFRESH_SECRET="dev-refresh-secret-replace-me"

# Email (Resend) — leave blank locally; emails log to console
RESEND_API_KEY=""

# Cloudflare R2 — leave blank locally; uploads can use a local dev folder
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jobportal-dev"

# Stripe — Phase 2 only, leave blank for now
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry / PostHog — optional locally. Blank values produce zero events.
# Server-side (API + RSC/instrumentation in Next)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Browser-side. Same DSN/key is safe to expose — these are public ingest
# tokens. They MUST be NEXT_PUBLIC_-prefixed so Next inlines them into
# the client bundle.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Build-time sourcemap upload (set in CI; blank locally). Used by the
# @sentry/nextjs webpack plugin during `next build`.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# App URLs (for cross-app links + CORS)
WEB_URL="http://localhost:3000"
RECRUITER_URL="http://localhost:3001"
SERVICES_URL="http://localhost:3002"
API_URL="http://localhost:4000"
