# Database
DATABASE_URL="postgresql://jobportal:jobportal@localhost:5432/jobportal_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-replace-me"
JWT_REFRESH_SECRET="dev-refresh-secret-replace-me"

# Email (Resend) — leave blank locally; emails log to console (no-op stub).
# Set RESEND_API_KEY to actually deliver mail (verification links, etc.).
RESEND_API_KEY=""
# Sender address. MUST be on a domain verified in Resend, or every send is
# rejected. Production uses "Career Queue <noreply@careerqueue.in>"
# (careerqueue.in verified 2026-09-05). The fallback baked into the code is
# "JobPortal <noreply@jobportal.com>", which is NOT a domain we own and will be
# rejected — so if you set a key, set this too.
#
# onboarding@resend.dev is Resend's shared sender and needs no domain setup,
# but it delivers ONLY to your own Resend-account email. Fine for a smoke test,
# useless for testing with other addresses.
#
# Leaving RESEND_API_KEY blank is the normal local setup: no mail is sent and
# signup codes print to the API console instead. NOTE the trade-off — setting a
# key switches that console line OFF, so set both or neither.
RESEND_FROM="Career Queue <noreply@careerqueue.in>"

# Help & Support ops inbox. When set, Contact Us submissions and newly raised
# support tickets are forwarded here (best-effort; the DB row is the record).
# Leave blank to skip the email entirely (local default).
SUPPORT_INBOX_EMAIL=""

# Cloudflare R2 — leave blank locally; uploads can use a local dev folder
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="jobportal-dev"
# Public base URL for PERMANENTLY-public assets (company logos rendered on the
# public site, cached by Cloudflare). In prod set to your CDN / R2 public domain
# (e.g. https://cdn.jobportal.com) — it must be whitelisted in each Next app's
# next.config images.remotePatterns. Leave BLANK locally: the API then serves
# logos from its own /media passthrough (http://localhost:4000/media/...) so
# uploads still render in dev. Public logos are never signed/expiring.
R2_PUBLIC_URL=""

# Stripe — Phase 2 only, leave blank for now
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (recruiter Plans & Billing) — leave ALL blank locally: the gateway
# runs in a keyless stub mode (fake order ids + a dev-only "simulate payment"
# button) so the whole purchase flow works with no Razorpay account. Set the
# rzp_test_* key pair from https://dashboard.razorpay.com → Settings → API Keys
# to exercise real test-mode Checkout. RAZORPAY_WEBHOOK_SECRET is the separate
# secret configured on the dashboard's webhook (events: payment.captured,
# order.paid, payment.failed → POST {API_URL}/webhooks/razorpay).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Seller identity printed on GST invoices (CGST Rule 46). SELLER_STATE drives
# the CGST+SGST (intra-state) vs IGST (inter-state) split against the buyer's
# billing state. SAC 998519 (employment & labour supply services) is a
# placeholder — confirm with a CA before live billing.
BILLING_SELLER_NAME="Career Queue"
BILLING_SELLER_GSTIN=""
BILLING_SELLER_ADDRESS=""
BILLING_SELLER_STATE="Maharashtra"
BILLING_SAC_CODE="998519"

# Sentry / PostHog — optional locally. Blank values produce zero events.
# Server-side (API + RSC/instrumentation in Next)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Browser-side. Same DSN/key is safe to expose — these are public ingest
# tokens. They MUST be NEXT_PUBLIC_-prefixed so Next inlines them into
# the client bundle.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Build-time sourcemap upload (set in CI; blank locally). Used by the
# @sentry/nextjs webpack plugin during `next build`.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# How far apps/api trusts X-Forwarded-For when deriving req.ip.
#
# LEAVE THIS UNSET LOCALLY. Unset means "ignore X-Forwarded-For and use the
# socket peer", which is correct when nothing sits in front of the process.
#
# SET IT ON EVERY HOSTED DEPLOYMENT. Behind a reverse proxy, req.ip is the
# PROXY's address unless this is set — and req.ip is what the global 100/min
# throttle is keyed on, what the per-IP login throttle counts, and what lands in
# Session.ipAddress and OtpChallenge.ipAddress. Unset in production therefore
# means one shared rate-limit bucket for the entire internet, and audit rows
# that all record the same address.
#
# The value is the number of proxies actually in front of this process:
#   1  → Render or Fly alone
#   2  → Cloudflare in front of Render/Fly
# Express presets ("loopback", "uniquelocal") and comma-separated IP/CIDR
# allowlists also work.
#
# Do NOT set it to "true". That trusts the whole forwarded chain, so any client
# can send its own X-Forwarded-For and become any address it likes — which does
# not weaken the rate limiter, it removes it. The API logs a warning at boot if
# it sees "true", or if it is unset while NODE_ENV=production.
TRUST_PROXY=""

# App URLs (for cross-app links + CORS)
WEB_URL="http://localhost:3000"
RECRUITER_URL="http://localhost:3001"
SERVICES_URL="http://localhost:3002"
# Internal Super Admin portal (apps/sadmin). ORIGIN ONLY — the app is served
# under basePath '/sadmin', but a CORS origin never carries a path. This value
# is read by apps/api's CORS allowlist; if it is wrong, every sign-in from the
# portal fails with what looks like an auth error but is actually a blocked
# preflight.
SADMIN_URL="http://localhost:3003"
API_URL="http://localhost:4000"

# Web → API base URL (browser-side; used for auth fetches + the Google button
# target). Falls back to http://localhost:4000 when unset.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Seeker-site origin as seen from the OTHER apps' browser bundles (recruiter
# portal cross-links: non-recruiter redirect, View public job page / Share on
# the Jobs list). Falls back to http://localhost:3000 when unset — set it in
# production or the links point at localhost.
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Google OAuth (SRS §4.12.6, ADR 0001) — leave blank locally; the "Continue
# with Google" buttons stay hidden and the /auth/google routes 404 until all
# three are set. Create a Web-application OAuth client at
# https://console.cloud.google.com → APIs & Services → Credentials, and add the
# redirect URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Mobile social sign-in (ADR 0002) — the `aud` allowlist for ID tokens the APP
# posts to /v1/auth/mobile/{google,apple}.
#
# This is a security control, not plumbing. Google will happily sign a valid
# token for ANY app's client id; pinning `aud` is what distinguishes a token
# minted for us from one minted for someone else's app and replayed here.
#
# APPLE IS OFF UNTIL SET: an empty list rejects every token, so forgetting it
# fails closed.
#
# GOOGLE IS NOT, and the difference is deliberate — GOOGLE_CLIENT_ID (the web
# client, already configured) is accepted automatically, so the mobile route
# will honour a token minted for the WEB client even with the line below blank.
# That is still one of OUR client ids, not anyone else's, but it does mean
# "blank" does not mean "Google mobile sign-in is disabled".
#
# GOOGLE: comma-separated ANDROID and iOS OAuth client ids from the same Google
# Cloud project as GOOGLE_CLIENT_ID above (Credentials → Create credentials →
# OAuth client ID → Android / iOS). GOOGLE_CLIENT_ID is accepted automatically,
# so web-issued tokens keep working without repeating it here.
GOOGLE_MOBILE_CLIENT_IDS=""

# APPLE: comma-separated. The iOS app's BUNDLE ID for tokens from the native
# Sign in with Apple sheet, plus a Services ID if Apple sign-in is ever added
# to the website. There is no fallback — Apple has no pre-existing flow here.
#
# Apple sign-in is REQUIRED on iOS by App Store Review Guideline 4.8 once any
# other third-party social login ships, so shipping Google without this will
# fail review.
APPLE_CLIENT_IDS=""

# Super Admin seed (apps/sadmin). `pnpm db:seed` upserts one ADMIN user so every
# developer can sign in to the Super Admin portal straight after pulling. Leave
# BOTH blank (as shipped) to get the documented dev credential:
#     admin@careerqueue.in / Admin@123
# The password is re-applied on every seed run, so a locally-changed one is reset
# back to this — deliberate, so every machine converges on the same credential.
# Re-seeding also revokes that account's existing sessions.
#
# While the password is still the repo default, the seed SKIPS this step unless
# DATABASE_URL looks local (localhost / 127.0.0.1 / .local / .internal) or
# NODE_ENV is production — the same guard the demo seed uses — so a committed
# credential cannot land on staging or production. Set SADMIN_SEED_PASSWORD to a
# real secret to provision an admin on a remote database deliberately.
SADMIN_SEED_EMAIL=""
SADMIN_SEED_PASSWORD=""

# Cookie domain — blank locally (host-only on localhost). In production set to a
# shared parent (e.g. .yourdomain.com) so the cookie the API origin sets is
# readable by the web origin across subdomains.
COOKIE_DOMAIN=""
