# ============================================================
# JobPortal — .gitignore
# Monorepo: Next.js 16 + NestJS 11 + Prisma 7 + Turborepo + pnpm
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*
.yarn/
.yarn-integrity
jspm_packages/
web_modules/
# Non-pnpm lockfiles — this repo uses pnpm (pnpm-lock.yaml) only. A stray
# `npm install` / `yarn` must not commit a competing lockfile.
package-lock.json
yarn.lock

# ---------- Environment variables (NEVER commit) ----------
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.staging.local
.env.production
.env.production.local
# Keep the template
!.env.example

